{
  "expo": {
    "name": "Forest App",
    "slug": "TourDiary",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "forestapp",
    "ios": {
      "bundleIdentifier": "com.vikasjusta.tourdiary",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vikasjusta.tourdiary",
      "adaptiveIcon": {
        "backgroundColor": "#1F4422",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Forest App needs camera access to take GPS-stamped tour photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Forest App needs your location to stamp photos with GPS coordinates."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F4422",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Forest App needs access to your photos to save pictures you take.",
          "savePhotosPermission": "Forest App needs permission to save photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Forest App needs access to your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F7D50",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "919bb526-3328-4d62-a81e-367ba2d51449"
      }
    },
    "owner": "amanjusta"
  }
}
