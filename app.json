{
  "expo": {
    "name": "TourDiary",
    "slug": "TourDiary",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.vikasjusta.tourdiary",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vikasjusta.tourdiary",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TourDiary needs camera access to take GPS-stamped tour photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TourDiary needs your location to stamp photos with GPS coordinates."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "TourDiary needs access to your photos to save pictures you take.",
          "savePhotosPermission": "TourDiary needs permission to save photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
